[Unit]
Description=Authenticated Web Terminal (ttyd)
After=network.target
Wants=network.target

[Service]
Type=simple
EnvironmentFile=/run/ttyd.env
ExecStart=/bin/sh -c 'exec /usr/local/bin/ttyd -p 3000 -i 0.0.0.0 -c "$TTTYD_CREDENTIALS" -W /bin/sh'
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
