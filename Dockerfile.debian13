FROM debian:13-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV HOME=/home/kasm_user
ENV DISPLAY=:1
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8
ENV LANGUAGE=en_US:en

RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    curl \
    ca-certificates \
    sudo \
    ssl-cert \
    supervisor \
    python3 \
    openbox \
    obconf \
    tint2 \
    pcmanfm \
    xfce4-terminal \
    xfce4-appfinder \
    mousepad \
    zenity \
    firefox-esr \
    libnotify-bin \
    greybird-gtk-theme \
    papirus-icon-theme \
    fonts-hosny-amiri \
    fonts-kacst-one \
    fonts-noto-core \
    fonts-dejavu-core \
    libfribidi0 \
    locales \
    x11-xkb-utils \
    xkb-data \
    x11-xserver-utils \
    net-tools \
    procps \
    && sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen \
    && sed -i '/ar_EG.UTF-8/s/^# //g' /etc/locale.gen \
    && locale-gen \
    && wget -q https://github.com/kasmtech/KasmVNC/releases/download/v1.5.0/kasmvncserver_trixie_1.5.0_amd64.deb \
    && apt-get install -y --no-install-recommends ./kasmvncserver_trixie_1.5.0_amd64.deb \
    && rm -f kasmvncserver_trixie_1.5.0_amd64.deb \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /tmp/.X11-unix && chmod 1777 /tmp/.X11-unix

RUN echo 'XKBMODEL="pc105"\nXKBLAYOUT="us,ar"\nXKBVARIANT=","\nXKBOPTIONS="grp:alt_shift_toggle"' > /etc/default/keyboard

RUN useradd -u 1000 -m -s /bin/bash -g ssl-cert kasm_user && \
    echo "kasm_user:cranl1234" | chpasswd && \
    echo "kasm_user ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Install systemctl emulation and supervisor config
COPY systemctl.py /usr/local/bin/systemctl
COPY supervisord.conf /etc/supervisor/supervisord.conf
COPY sample-service.service /etc/systemd/system/sample-service.service
COPY web-terminal.service /etc/systemd/system/web-terminal.service
COPY services-manager.sh /usr/local/bin/services-manager.sh
COPY switch-lang.sh /usr/local/bin/switch-lang.sh

RUN chmod +x /usr/local/bin/systemctl /usr/local/bin/services-manager.sh /usr/local/bin/switch-lang.sh && \
    ln -sf /usr/local/bin/systemctl /bin/systemctl && \
    ln -sf /usr/local/bin/systemctl /usr/bin/systemctl && \
    ln -sf /usr/local/bin/systemctl /sbin/service && \
    ln -sf /usr/local/bin/systemctl /usr/sbin/service && \
    mkdir -p /etc/systemd/system/multi-user.target.wants && \
    ln -sf /etc/systemd/system/sample-service.service /etc/systemd/system/multi-user.target.wants/sample-service.service && \
    ln -sf /etc/systemd/system/web-terminal.service /etc/systemd/system/multi-user.target.wants/web-terminal.service

# Pre-configure user directories and desktop configs
RUN mkdir -p /home/kasm_user/Desktop \
             /home/kasm_user/.config/openbox \
             /home/kasm_user/.config/tint2 \
             /home/kasm_user/.config/pcmanfm/default \
             /home/kasm_user/.config/gtk-3.0 \
             /home/kasm_user/.config/xfce4/terminal \
             /usr/share/applications

COPY entrypoint.sh /home/kasm_user/entrypoint.sh
COPY autostart /home/kasm_user/.config/openbox/autostart
COPY menu.xml /home/kasm_user/.config/openbox/menu.xml
COPY tint2rc /home/kasm_user/.config/tint2/tint2rc
COPY terminalrc /home/kasm_user/.config/xfce4/terminal/terminalrc
COPY pcmanfm.conf /home/kasm_user/.config/pcmanfm/default/pcmanfm.conf
COPY desktop-items-0.conf /home/kasm_user/.config/pcmanfm/default/desktop-items-0.conf

RUN echo '[Settings]\ngtk-theme-name = Greybird-dark\ngtk-icon-theme-name = Papirus-Dark\ngtk-font-name = Noto Sans 10\ngtk-application-prefer-dark-theme = true' > /home/kasm_user/.config/gtk-3.0/settings.ini && \
    echo 'gtk-theme-name="Greybird-dark"\ngtk-icon-theme-name="Papirus-Dark"\ngtk-font-name="Noto Sans 10"' > /home/kasm_user/.gtkrc-2.0

# Desktop and menu shortcuts
RUN echo '[Desktop Entry]\nVersion=1.0\nType=Application\nName=Applications (قائمة البرامج)\nComment=Search and Launch Applications\nExec=xfce4-appfinder\nIcon=xfce4-appfinder\nTerminal=false\nCategories=System;' > /home/kasm_user/Desktop/AppMenu.desktop && \
    echo '[Desktop Entry]\nVersion=1.0\nType=Application\nName=Services Manager (مدير الخدمات)\nComment=Graphical Systemd Services Manager\nExec=/usr/local/bin/services-manager.sh\nIcon=preferences-system\nTerminal=false\nCategories=System;Settings;' > /home/kasm_user/Desktop/Services.desktop && \
    echo '[Desktop Entry]\nVersion=1.0\nType=Application\nName=Web Browser (متصفح الإنترنت)\nComment=Firefox Web Browser\nExec=firefox-esr\nIcon=firefox-esr\nTerminal=false\nCategories=Network;WebBrowser;' > /home/kasm_user/Desktop/Browser.desktop && \
    echo '[Desktop Entry]\nVersion=1.0\nType=Application\nName=Files (مدير الملفات)\nComment=PCManFM File Manager\nExec=pcmanfm\nIcon=system-file-manager\nTerminal=false\nCategories=System;' > /home/kasm_user/Desktop/Files.desktop && \
    echo '[Desktop Entry]\nVersion=1.0\nType=Application\nName=Terminal (الطرفية)\nComment=Command Line Terminal\nExec=xfce4-terminal\nIcon=utilities-terminal\nTerminal=false\nCategories=System;' > /home/kasm_user/Desktop/Terminal.desktop && \
    echo '[Desktop Entry]\nVersion=1.0\nType=Application\nName=Text Editor (محرر النصوص)\nComment=Mousepad Text Editor\nExec=mousepad\nIcon=accessories-text-editor\nTerminal=false\nCategories=Utility;' > /home/kasm_user/Desktop/TextEditor.desktop && \
    echo '[Desktop Entry]\nVersion=1.0\nType=Application\nName=Switch Language (تبديل اللغة)\nComment=Toggle Arabic and English (or press Alt+Shift)\nExec=/usr/local/bin/switch-lang.sh\nIcon=preferences-desktop-keyboard\nTerminal=false\nCategories=Utility;' > /home/kasm_user/Desktop/SwitchLanguage.desktop && \
    cp /home/kasm_user/Desktop/*.desktop /usr/share/applications/ && \
    echo "alias ar='setxkbmap -layout ar,us -option grp:alt_shift_toggle && echo Language: Arabic'" >> /home/kasm_user/.bashrc && \
    echo "alias en='setxkbmap -layout us,ar -option grp:alt_shift_toggle && echo Language: US English'" >> /home/kasm_user/.bashrc && \
    chmod +x /home/kasm_user/entrypoint.sh /home/kasm_user/.config/openbox/autostart /home/kasm_user/Desktop/*.desktop && \
    chown -R kasm_user:ssl-cert /home/kasm_user

EXPOSE 3000

USER kasm_user
WORKDIR /home/kasm_user

ENTRYPOINT ["/home/kasm_user/entrypoint.sh"]
