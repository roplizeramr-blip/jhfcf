FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV HOME=/home/kasm_user
ENV DISPLAY=:1
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8
ENV LANGUAGE=en_US:en

RUN touch /var/mail/ubuntu 2>/dev/null || true && \
    userdel -r ubuntu 2>/dev/null || true

# Add Mozilla APT repo for native Firefox (non-snap)
RUN apt-get update && apt-get install -y --no-install-recommends wget ca-certificates gnupg \
    && install -d -m 0755 /etc/apt/keyrings \
    && wget -q https://packages.mozilla.org/apt/repo-signing-key.gpg -O- | gpg --dearmor | tee /etc/apt/keyrings/packages.mozilla.org.gpg > /dev/null \
    && echo "deb [signed-by=/etc/apt/keyrings/packages.mozilla.org.gpg] https://packages.mozilla.org/apt mozilla main" | tee /etc/apt/sources.list.d/mozilla.list > /dev/null \
    && echo "Package: *\nPin: origin packages.mozilla.org\nPin-Priority: 1000\n\nPackage: firefox*\nPin: release o=Ubuntu*\nPin-Priority: -1" | tee /etc/apt/preferences.d/mozilla \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    curl \
    ca-certificates \
    sudo \
    ssl-cert \
    supervisor \
    python3 \
    xfwm4 \
    xfce4-panel \
    xfdesktop4 \
    xfce4-settings \
    xfce4-session \
    xfce4-terminal \
    xfce4-appfinder \
    xfce4-whiskermenu-plugin \
    thunar \
    mousepad \
    zenity \
    firefox \
    dbus-x11 \
    libnotify-bin \
    greybird-gtk-theme \
    papirus-icon-theme \
    fonts-noto-color-emoji \
    fonts-hosny-amiri \
    fonts-kacst-one \
    fonts-noto-core \
    fonts-dejavu-core \
    libfribidi0 \
    locales \
    x11-xkb-utils \
    xkb-data \
    x11-xserver-utils \
    net-tools \
    procps \
    && sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen \
    && sed -i '/ar_EG.UTF-8/s/^# //g' /etc/locale.gen \
    && locale-gen \
    && wget -q https://github.com/kasmtech/KasmVNC/releases/download/v1.5.0/kasmvncserver_noble_1.5.0_amd64.deb \
    && apt-get install -y --no-install-recommends ./kasmvncserver_noble_1.5.0_amd64.deb \
    && rm -f kasmvncserver_noble_1.5.0_amd64.deb \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /tmp/.X11-unix && chmod 1777 /tmp/.X11-unix

RUN echo 'XKBMODEL="pc105"\nXKBLAYOUT="us,ar"\nXKBVARIANT=","\nXKBOPTIONS="grp:alt_shift_toggle"' > /etc/default/keyboard

RUN useradd -u 1000 -m -s /bin/bash -g ssl-cert kasm_user && \
    echo "kasm_user:cranl1234" | chpasswd && \
    echo "kasm_user ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Install systemctl emulation and supervisor config
COPY systemctl.py /usr/local/bin/systemctl
COPY supervisord.conf /etc/supervisor/supervisord.conf
COPY sample-service.service /etc/systemd/system/sample-service.service
COPY web-terminal.service /etc/systemd/system/web-terminal.service
COPY services-manager.sh /usr/local/bin/services-manager.sh
COPY switch-lang.sh /usr/local/bin/switch-lang.sh

RUN chmod +x /usr/local/bin/systemctl /usr/local/bin/services-manager.sh /usr/local/bin/switch-lang.sh && \
    ln -sf /usr/local/bin/systemctl /bin/systemctl && \
    ln -sf /usr/local/bin/systemctl /usr/bin/systemctl && \
    ln -sf /usr/local/bin/systemctl /sbin/service && \
    ln -sf /usr/local/bin/systemctl /usr/sbin/service && \
    mkdir -p /etc/systemd/system/multi-user.target.wants && \
    ln -sf /etc/systemd/system/sample-service.service /etc/systemd/system/multi-user.target.wants/sample-service.service && \
    ln -sf /etc/systemd/system/web-terminal.service /etc/systemd/system/multi-user.target.wants/web-terminal.service

# Pre-configure user directories and XFCE desktop configs
RUN mkdir -p /home/kasm_user/Desktop \
             /home/kasm_user/.config/xfce4/xfconf/xfce-perchannel-xml \
             /home/kasm_user/.config/gtk-3.0 \
             /home/kasm_user/.config/xfce4/terminal \
             /usr/share/applications

COPY entrypoint.sh /home/kasm_user/entrypoint.sh
COPY xfce4-desktop.xml /home/kasm_user/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml
COPY xsettings.xml /home/kasm_user/.config/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml
COPY xfwm4.xml /home/kasm_user/.config/xfce4/xfconf/xfce-perchannel-xml/xfwm4.xml
COPY xfce4-power-manager.xml /home/kasm_user/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-power-manager.xml
COPY terminalrc /home/kasm_user/.config/xfce4/terminal/terminalrc

# Copy default panel xml to avoid first-run wizard
RUN cp /etc/xdg/xfce4/panel/default.xml /home/kasm_user/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml 2>/dev/null || true

# Desktop shortcuts
RUN echo '[Desktop Entry]\nVersion=1.0\nType=Application\nName=Services Manager (مدير الخدمات)\nComment=Graphical Systemd Services Manager\nExec=/usr/local/bin/services-manager.sh\nIcon=system-run\nTerminal=false\nCategories=System;Settings;' > /home/kasm_user/Desktop/Services.desktop && \
    echo '[Desktop Entry]\nVersion=1.0\nType=Application\nName=Terminal (الطرفية)\nComment=Command Line Terminal\nExec=xfce4-terminal\nIcon=utilities-terminal\nTerminal=false\nCategories=System;' > /home/kasm_user/Desktop/Terminal.desktop && \
    echo '[Desktop Entry]\nVersion=1.0\nType=Application\nName=Files (مدير الملفات)\nComment=Thunar File Manager\nExec=thunar\nIcon=system-file-manager\nTerminal=false\nCategories=System;' > /home/kasm_user/Desktop/Files.desktop && \
    echo '[Desktop Entry]\nVersion=1.0\nType=Application\nName=Web Browser (متصفح الإنترنت)\nComment=Firefox Web Browser\nExec=firefox\nIcon=firefox\nTerminal=false\nCategories=Network;WebBrowser;' > /home/kasm_user/Desktop/Browser.desktop && \
    echo '[Desktop Entry]\nVersion=1.0\nType=Application\nName=Text Editor (محرر النصوص)\nComment=Mousepad Text Editor\nExec=mousepad\nIcon=accessories-text-editor\nTerminal=false\nCategories=Utility;' > /home/kasm_user/Desktop/TextEditor.desktop && \
    echo '[Desktop Entry]\nVersion=1.0\nType=Application\nName=Switch Language (تبديل اللغة)\nComment=Toggle Arabic and English (or press Alt+Shift)\nExec=/usr/local/bin/switch-lang.sh\nIcon=preferences-desktop-keyboard\nTerminal=false\nCategories=Utility;' > /home/kasm_user/Desktop/SwitchLanguage.desktop && \
    cp /home/kasm_user/Desktop/*.desktop /usr/share/applications/ && \
    echo "alias ar='setxkbmap -layout ar,us -option grp:alt_shift_toggle && echo Language: Arabic'" >> /home/kasm_user/.bashrc && \
    echo "alias en='setxkbmap -layout us,ar -option grp:alt_shift_toggle && echo Language: US English'" >> /home/kasm_user/.bashrc && \
    chmod +x /home/kasm_user/entrypoint.sh /home/kasm_user/Desktop/*.desktop && \
    chown -R kasm_user:ssl-cert /home/kasm_user

EXPOSE 3000

USER kasm_user
WORKDIR /home/kasm_user

ENTRYPOINT ["/home/kasm_user/entrypoint.sh"]
