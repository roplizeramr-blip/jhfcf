FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV HOME=/home/kasm_user
ENV DISPLAY=:1
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8
ENV LANGUAGE=en_US:en

RUN touch /var/mail/ubuntu 2>/dev/null || true && \
    userdel -r ubuntu 2>/dev/null || true

RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    curl \
    ca-certificates \
    sudo \
    ssl-cert \
    dbus-x11 \
    xfwm4 \
    xfce4-panel \
    xfdesktop4 \
    xfce4-terminal \
    xfce4-settings \
    thunar \
    mousepad \
    xfce4-xkb-plugin \
    libnotify-bin \
    greybird-gtk-theme \
    papirus-icon-theme \
    fonts-hosny-amiri \
    fonts-kacst-one \
    fonts-noto-core \
    fonts-dejavu-core \
    libfribidi0 \
    locales \
    x11-xkb-utils \
    xkb-data \
    x11-xserver-utils \
    net-tools \
    procps \
    && sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen \
    && sed -i '/ar_EG.UTF-8/s/^# //g' /etc/locale.gen \
    && locale-gen \
    && wget -q https://github.com/kasmtech/KasmVNC/releases/download/v1.5.0/kasmvncserver_noble_1.5.0_amd64.deb \
    && apt-get install -y --no-install-recommends ./kasmvncserver_noble_1.5.0_amd64.deb \
    && rm -f kasmvncserver_noble_1.5.0_amd64.deb \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /tmp/.X11-unix && chmod 1777 /tmp/.X11-unix

RUN echo 'XKBMODEL="pc105"\nXKBLAYOUT="us,ar"\nXKBVARIANT=","\nXKBOPTIONS="grp:alt_shift_toggle"' > /etc/default/keyboard

RUN useradd -u 1000 -m -s /bin/bash -g ssl-cert kasm_user && \
    echo "kasm_user:cranl1234" | chpasswd && \
    echo "kasm_user ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

COPY entrypoint.sh /entrypoint.sh
COPY start-desktop.sh /home/kasm_user/start-desktop.sh

RUN chmod +x /entrypoint.sh /home/kasm_user/start-desktop.sh && \
    chown kasm_user:ssl-cert /home/kasm_user/start-desktop.sh

EXPOSE 3000

USER root
ENTRYPOINT ["/entrypoint.sh"]
