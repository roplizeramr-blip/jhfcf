<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu xmlns="http://openbox.org/3.4/menu">
  <menu id="root-menu" label="Applications">
    <item label="🔍 All Applications (كافة البرامج)">
      <action name="Execute"><command>xfce4-appfinder</command></action>
    </item>
    <separator />
    <item label="⚙️ Services Manager (إدارة الخدمات Systemd)">
      <action name="Execute"><command>/usr/local/bin/services-manager.sh</command></action>
    </item>
    <item label="🌐 Web Browser (متصفح الإنترنت)">
      <action name="Execute"><command>sh -c "which firefox && firefox || firefox-esr"</command></action>
    </item>
    <item label="📁 File Manager (مدير الملفات)">
      <action name="Execute"><command>pcmanfm</command></action>
    </item>
    <item label="💻 Terminal (الطرفية)">
      <action name="Execute"><command>xfce4-terminal</command></action>
    </item>
    <item label="📝 Text Editor (محرر النصوص)">
      <action name="Execute"><command>mousepad</command></action>
    </item>
    <item label="⌨️ Switch Language (تبديل اللغة)">
      <action name="Execute"><command>/usr/local/bin/switch-lang.sh</command></action>
    </item>
  </menu>
</openbox_menu>
